# Copy to .env and fill in. .env is gitignored — never commit the token.
DNS_SERVICE_URL=https://erpnet-fp-dns.t-core.io
# Shared first-boot provisioning token from the ErpNet.FP.DNS admin.
INSTALL_TOKEN=
# Stable, clearly-non-production id for this dev box. Becomes the subdomain:
#   <DEVICE_ID>.fiscal.t-core.io
DEVICE_ID=dev-odoo16-fp
PORT=8001
